root = true

# NOTE: the one-byte include/lang/ files (cz_*, sk_*, ...) are deliberately generated
# as pure ASCII (\xNN escapes), so "charset = utf-8" cannot corrupt them. Translation
# masters (xx-utf8_*) are real UTF-8. See include/lang/readme.html.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,neon}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
