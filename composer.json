{
  "name": "apc/actionapps",
  "description": "ActionApps is a collaborative web publishing tool and an open-source development platform for web applications.",
  "keywords": ["CMS"],
  "type": "project",
  "homepage": "https://actionapps.org",
  "license": "GPL-2.0-or-later",
  "authors": [
        {
            "name": "Honza Malik",
            "email": "honza.malik@ecn.cz",
            "homepage": "https://ecnstudio.cz",
            "role": "Developer"
        }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/honzito/phpThumb.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/honzito/iban-validation.git"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-ctype": "*",
    "firebase/php-jwt": "v6.*",
    "mobiledetect/mobiledetectlib": "2.*",
    "phpgangsta/googleauthenticator": "dev-master",
    "horde/text_diff": "v3.*",
    "honzito/qr-platba": "@dev",
    "honzito/phpthumb": "dev-justcode",
    "ext-iconv": "*",
    "ext-zlib": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-dom": "*",
    "ext-xsl": "*",
    "ext-simplexml": "*",
    "ext-xml": "*",
    "ext-intl": "*",
    "ext-pdo": "*",
    "ext-fileinfo": "*"
  },
  "commented-out-r-equire-dev": {
    "codeception/codeception": "^5.1"
  },
  "suggest": {
    "ext-ldap": "*",
    "ext-openssl": "*",
    "ext-apache": "*",
    "ext-mysqli": "*",
    "ext-libxml": "*",
    "ext-ftp": "*",
    "ext-soap": "*"
  },
  "autoload": {
    "classmap": ["include/","src/"],
    "exclude-from-classmap": ["include/custom/"]
  },
  "config": {
    "discard-changes": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "dev",
  "prefer-stable" : true
}
