{
  "name": "apc/actionapps",
  "description": "ActionApps is a collaborative web publishing tool and an open-source development platform for web applications.",
  "keywords": ["CMS"],
  "type": "project",
  "homepage": "https://actionapps.org",
  "license": "GPL-2.0-or-later",
  "authors": [
        {
            "name": "Honza Malik",
            "email": "honza.malik@ecn.cz",
            "homepage": "https://ecnstudio.cz",
            "role": "Developer"
        }
  ],
  "require": {
    "php": ">=7.2",
    "ext-json": "*",
    "ext-ctype": "*",
    "firebase/php-jwt": "v5.0.0",
    "mobiledetect/mobiledetectlib": "2.8.33",
    "jan-swiecki/simple-annotations": "0.3.1",
    "phpgangsta/googleauthenticator": "dev-master",
    "chillerlan/php-qrcode": "^3.3",
    "chillerlan/php-authenticator": "^3.0",
    "ext-iconv": "*",
    "ext-zlib": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-ldap": "*",
    "ext-dom": "*",
    "ext-xsl": "*",
    "ext-simplexml": "*",
    "ext-xml": "*",
    "ext-openssl": "*"
  },
  "suggest": {
    "ext-apache": "*"
  },
  "autoload": {
    "psr-4": {
      "AA\\": "src/"
    },
    "classmap": ["include/"],
    "exclude-from-classmap": ["include/custom/"]
  }
}
