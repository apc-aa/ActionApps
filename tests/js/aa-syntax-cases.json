{
    "about": "How AA reads {...} in templates. spans: [kind, from, to, name, seps] from scan() of dev/codemirror6/aa-syntax.js; output: what AA::Un() returns (StringexpandSyntaxCasesTest checks it on the real expander). contexts: | marks the cursor for contextAt(); start - where the parameter begins.",
    "scan": [
        {"input": "a{# x}b", "spans": [["comment", 1, 6]], "output": "ab"},
        {"input": "a{#\n  multi\n  line\n}b", "spans": [["comment", 1, 20]], "output": "ab"},
        {"input": "x{#}y", "spans": [["comment", 1, 4]], "output": "xy"},
        {"input": "{#{#a}b}", "spans": [["comment", 0, 8], ["comment", 2, 6]], "output": ""},
        {"input": "{ifset:1:{# c}yes:no}", "spans": [["expr", 0, 21, "ifset", [6, 8, 17]], ["comment", 9, 14]], "output": "yes"},
        {"input": "{ifset:1:a{# x}b:no}", "spans": [["expr", 0, 20, "ifset", [6, 8, 16]], ["comment", 10, 15]], "output": "ab"},
        {"input": "{#a}}", "spans": [["comment", 0, 4]], "output": "}"},
        {"input": "{{#a}", "spans": [["comment", 1, 5]], "output": "{"},
        {"input": "a{#b", "spans": [], "output": "a{#b"},
        {"input": "{}", "spans": [], "output": "{}"},
        {"input": "x{a{}b}y", "spans": [], "output": "x{a{}b}y"},
        {"input": "{ifset:1:{}:no}", "spans": [], "output": "{ifset:1:{}:no}"},
        {"input": "a{# a {} b}c", "spans": [], "output": "a{# a {} b}c"},
        {"input": "{ifset:1:{}:{# x}}", "spans": [["comment", 12, 17]], "output": "{ifset:1:{}:}"},
        {"input": "a{ color: red }b", "spans": [["literal", 1, 15]], "output": "a{ color: red }b"},
        {"input": "{\n  margin: 0\n}", "spans": [["literal", 0, 15]], "output": "{\n  margin: 0\n}"},
        {"input": "{IFSET:1:yes}", "spans": [["expr", 0, 13, "IFSET", [6, 8]]], "output": "yes"},
        {"input": "{ifset::a:x:b:c}", "spans": [["expr", 0, 16, "ifset", [6, 7, 9, 11, 13]]], "output": "b"},
        {"input": "{ifeq:a:a:http://x.cz:no}", "spans": [["expr", 0, 25, "ifeq", [5, 7, 9, 21]]], "output": "http://x.cz"},
        {"input": "{ifeq:a:a:https://x.cz/p:no}", "spans": [["expr", 0, 28, "ifeq", [5, 7, 9, 24]]], "output": "https://x.cz/p"},
        {"input": "{ifeq:a:a:mailto:x:no}", "spans": [["expr", 0, 22, "ifeq", [5, 7, 9, 16, 18]]], "output": "mailto"},
        {"input": "{ifeq:a:a:x#:y:no}", "spans": [["expr", 0, 18, "ifeq", [5, 7, 9, 14]]], "output": "x:y"},
        {"input": "{ifeq:a:a:a##:b:no}", "spans": [["expr", 0, 19, "ifeq", [5, 7, 9, 15]]], "output": "a#:b"},
        {"input": "{ifeq:a:a:{-p:q}:no}", "spans": [["expr", 0, 20, "ifeq", [5, 7, 9, 16]], ["expr", 10, 16, null, [13]]], "output": "p:q"},
        {"input": "{ifset:1:{(p:q)}:no}", "spans": [["expr", 0, 20, "ifset", [6, 8, 16]], ["expr", 9, 16, null, [12]]], "output": "p:q"},
        {"input": "{-a:b}", "spans": [["expr", 0, 6, null, [3]]], "output": "a:b"},
        {"input": "{_:Shortcut:x}", "spans": [["expr", 0, 14, "_", [2, 11]]]},
        {"input": "{view.php?vid=1}", "spans": [["expr", 0, 16, null, []]]},
        {"input": "{headline........}", "spans": [["expr", 0, 18, null, []]]},
        {"input": "{_#HEADLINE}", "spans": [["expr", 0, 12, null, []]]},
        {"input": "{now}", "spans": [["expr", 0, 5, "now", []]]}
    ],
    "contexts": [
        {"input": "{ifset:a:b|", "name": "ifset", "param": 1, "start": 9},
        {"input": "{ifset:|}", "name": "ifset", "param": 0},
        {"input": "{ifs|", "name": "ifs", "param": -1, "start": 1},
        {"input": "{ifset|:x}", "name": "ifset", "param": -1},
        {"input": "{IFSET:a:|", "name": "ifset", "param": 1},
        {"input": "{ifset:{ifeq:x:|}}", "name": "ifeq", "param": 1, "start": 15},
        {"input": "{ifset:a:{-x:y}:|", "name": "ifset", "param": 2},
        {"input": "{ifeq:a:http://x|", "name": "ifeq", "param": 1, "start": 8},
        {"input": "{# {ifset:|", "name": "ifset", "param": 0},
        {"input": "{ifset:a}|", "name": null},
        {"input": "{ |", "name": null},
        {"input": "{#x|", "name": null},
        {"input": "{ifset:{(a:b|", "name": null},
        {"input": "{view.php?vid=1&x=|", "name": null},
        {"input": "{_#HEADLINE|", "name": null},
        {"input": "{ifset:1:{}:|", "name": null},
        {"input": "plain text|", "name": null}
    ]
}
