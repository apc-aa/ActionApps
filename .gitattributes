# No "* text=auto" on purpose: some third-party files (javascript/prototype, misc/htmleditor, WSDLs, a few
# docs) are stored with CRLF and must stay byte-exact. New files are LF by convention (doc/coding.html).
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
# byte-compared by SchemaTest (generated XSD) and substring-edited by it (fixture) - LF on every checkout
src/Central/Package/aa-app-1.xsd text eol=lf
tests/Unit/Central/Package/fixtures/*.xml text eol=lf
